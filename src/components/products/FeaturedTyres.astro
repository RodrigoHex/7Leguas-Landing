---
import { Image, Picture } from 'astro:assets';
import pirelliLogo from '../../assets/brand/pirelli-official.svg';
import showcaseBackground from '../../assets/featured/pirelli-showcase-porsche-911.png';
import { featuredBenefits, featuredServices, featuredTyresDescription } from '../../data/home';
import { createWhatsAppUrl } from '../../data/contact';

const tyresWhatsAppUrl = createWhatsAppUrl(
  'Hola, quiero información y una cotización de los neumáticos Pirelli disponibles. ¿Me pueden ayudar?',
);
---

<section class="showcase" id="productos" aria-labelledby="products-title">
  <div class="showcase-media" aria-hidden="true">
    <Picture src={showcaseBackground} formats={['avif', 'webp']} widths={[640, 960, 1280, 1600, 1920]} sizes="100vw" alt="" loading="lazy" />
  </div>
  <div class="showcase-wash" aria-hidden="true"></div>

  <div class="pirelli-badge">
    <Image src={pirelliLogo} alt="Pirelli" width={202} height={62} />
    <span>POWER IS NOTHING WITHOUT CONTROL</span>
  </div>

  <p class="road-message" aria-hidden="true"><span>Más kilómetros</span><span>Grandes historias</span></p>

  <div class="showcase-content container">
    <div class="showcase-copy">
      <p class="brand-line"><span>Grupo Llantero Siete Leguas</span></p>

      <h2 id="products-title"><strong>Neumáticos Pirelli</strong><span>en Siete Leguas</span></h2>

      <p class="showcase-intro">{featuredTyresDescription}</p>

      <div class="authorization" aria-label="Distribuidor autorizado a nivel nacional">
        <svg viewBox="0 0 48 56" aria-hidden="true">
          <path d="M24 3 43 10v15c0 13-7.4 23-19 28C12.4 48 5 38 5 25V10l19-7Z"></path>
          <path d="m16.5 27 5 5 11-13"></path>
        </svg>
        <span class="authorization-divider" aria-hidden="true"></span>
        <p><span>Distribuidor autorizado</span><strong>A nivel nacional</strong></p>
      </div>

      <div class="services-block">
        <h3>Servicios disponibles</h3>
        <div class="services-grid">
          {featuredServices.map((service) => (
            <article class="service-card">
              <span class="service-icon" aria-hidden="true">
                {service.id === 'online' ? (
                  <svg viewBox="0 0 32 32">
                    <path d="M3 5h3l3 16h15l3-11H8"></path>
                    <circle cx="12" cy="26" r="1.7"></circle>
                    <circle cx="23" cy="26" r="1.7"></circle>
                  </svg>
                ) : (
                  <svg viewBox="0 0 32 32"><path d="M19 5a7 7 0 0 0-8.6 8.6L4 20l8 8 6.4-6.4A7 7 0 0 0 27 13l-5 5-5-1-1-5 5-5Z"></path></svg>
                )}
              </span>
              <div><h4>{service.title}</h4><p>{service.description}</p></div>
            </article>
          ))}
        </div>
      </div>

      <div class="showcase-actions">
        <a
          class="showcase-cta"
          href={tyresWhatsAppUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ver neumáticos por WhatsApp; se abre en una nueva pestaña"
        >
          <span>Ver neumáticos</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5"></path></svg>
        </a>

        <ul class="benefits" aria-label="Beneficios">
          {featuredBenefits.map((benefit, index) => (
            <li>
              {index === 0 && (
                <svg viewBox="0 0 28 32" aria-hidden="true"><path d="m14 2 10 4v8c0 7-4 12.5-10 15-6-2.5-10-8-10-15V6l10-4Z"></path><path d="m9 15 3 3 7-8"></path></svg>
              )}
              {index === 1 && (
                <svg viewBox="0 0 34 28" aria-hidden="true"><path d="M2 5h18v16H2zM20 10h7l5 6v5H20z"></path><circle cx="8" cy="23" r="3"></circle><circle cx="26" cy="23" r="3"></circle></svg>
              )}
              {index === 2 && (
                <svg viewBox="0 0 32 30" aria-hidden="true"><circle cx="11" cy="9" r="5"></circle><circle cx="23" cy="10" r="4"></circle><path d="M2 27v-4c0-5 3.5-8 9-8s9 3 9 8v4M21 17c5 0 8 2.5 8 7v3"></path></svg>
              )}
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <p class="performance-message" aria-hidden="true">Desempeño<br />en cada camino</p>
</section>

<style>
  .showcase{position:relative;min-height:clamp(760px,53vw,850px);overflow:hidden;isolation:isolate;background:#f5f3ee;scroll-margin-top:calc(var(--header-height) + 16px)}
  .showcase-media,.showcase-wash{position:absolute;inset:0}.showcase-media{z-index:-3}.showcase-media :global(picture),.showcase-media :global(img){width:100%;height:100%}.showcase-media :global(img){object-fit:cover;object-position:center}
  .showcase-wash{z-index:-2;background:linear-gradient(90deg,rgb(250 249 246/.98) 0%,rgb(250 249 246/.93) 30%,rgb(250 249 246/.72) 43%,rgb(250 249 246/.1) 61%,transparent 72%),linear-gradient(180deg,rgb(255 255 255/.18),transparent 35%)}
  .showcase-content{position:relative;z-index:2;display:flex;min-height:inherit;align-items:center;padding-block:40px}.showcase-copy{width:min(680px,51%)}
  .brand-line{display:flex;align-items:center;gap:20px;margin:0 0 24px;color:#353535;font-size:11px;font-weight:600;letter-spacing:.34em;line-height:1.2;text-transform:uppercase}.brand-line::after{width:112px;height:2px;background:var(--color-yellow);content:''}
  h2{max-width:690px;margin:0;color:#111;font-size:var(--type-display);letter-spacing:-.04em;line-height:.96}h2 strong,h2 span{display:block}h2 strong{font-weight:850;white-space:nowrap}h2 span{margin-top:8px;font-weight:350}
  .showcase-intro{max-width:66ch;margin:24px 0 22px;color:#585858;font-size:var(--type-body);line-height:1.55}
  .authorization{display:flex;width:min(100%,650px);min-height:94px;align-items:center;gap:24px;border-radius:12px;padding:18px 28px;background:linear-gradient(135deg,#080808,#202020);box-shadow:0 18px 42px rgb(0 0 0/.16);color:#fff}.authorization svg{width:44px;flex:0 0 auto;fill:none;stroke:var(--color-yellow);stroke-linecap:round;stroke-linejoin:round;stroke-width:2}.authorization-divider{width:1px;height:54px;flex:0 0 auto;background:var(--color-yellow)}.authorization p{margin:0;text-transform:uppercase}.authorization p span,.authorization p strong{display:block}.authorization p span{font-size:12px;font-weight:600;letter-spacing:.28em;line-height:1.4}.authorization p strong{margin-top:4px;color:var(--color-yellow);font-size:21px;letter-spacing:.2em;line-height:1.2}
  .services-block{margin-top:22px}.services-block>h3{display:flex;align-items:center;gap:18px;margin:0 0 14px;font-size:23px;line-height:1.2}.services-block>h3::after{width:92px;height:2px;background:var(--color-yellow);content:''}
  .services-grid{display:grid;width:min(100%,680px);grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.service-card{display:grid;min-height:136px;grid-template-columns:54px 1fr;align-items:start;gap:16px;border:1px solid rgb(25 25 25/.13);border-radius:14px;padding:18px;background:rgb(255 255 255/.74)}.service-icon{display:grid;width:54px;height:54px;place-items:center;border-radius:50%;background:#111;color:var(--color-yellow)}.service-icon svg{width:29px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}.service-card h4{margin:1px 0 5px;font-size:var(--type-body);line-height:1.2}.service-card p{margin:0;color:#555;font-size:var(--type-small);line-height:1.5}
  .showcase-actions{display:flex;width:min(100%,820px);align-items:center;gap:28px;margin-top:22px}.showcase-cta{display:inline-flex;min-width:230px;min-height:58px;flex:0 0 auto;align-items:center;justify-content:center;gap:28px;border-radius:14px;padding:0 24px;background:var(--color-yellow);color:#111;font-size:15px;font-weight:800;text-decoration:none;transition:background var(--transition-fast),transform var(--transition-fast),box-shadow var(--transition-fast)}.showcase-cta svg{width:21px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8;transition:transform var(--transition-fast)}.showcase-cta:hover{background:var(--color-yellow-hover);box-shadow:0 12px 26px rgb(0 0 0/.13);transform:translateY(-2px)}.showcase-cta:hover svg{transform:translateX(4px)}
  .benefits{display:grid;flex:1;grid-template-columns:repeat(3,minmax(0,1fr));margin:0;padding:0;list-style:none}.benefits li{display:flex;min-height:38px;align-items:center;gap:9px;border-left:1px solid rgb(0 0 0/.32);padding-inline:18px}.benefits svg{width:25px;flex:0 0 auto;fill:none;stroke:#171717;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.5}.benefits span{font-size:11px;font-weight:700;letter-spacing:.08em;line-height:1.4;text-transform:uppercase}
  .pirelli-badge{position:absolute;z-index:3;top:42px;right:max(var(--page-gutter),calc((100vw - var(--page-max-width))/2));display:grid;justify-items:center}.pirelli-badge :global(img){width:202px;height:auto}.pirelli-badge span{margin-top:8px;color:#fff;font-size:7px;font-weight:700;letter-spacing:.2em}
  .road-message,.performance-message{position:absolute;z-index:2;right:max(38px,calc((100vw - var(--page-max-width))/2 + 20px));margin:0;color:#fff;text-transform:uppercase}.road-message{top:215px;display:grid;gap:8px;font-size:10px;font-weight:600;letter-spacing:.3em;line-height:1.5}.road-message::after{width:54px;height:2px;margin-top:3px;background:var(--color-yellow);content:''}.performance-message{right:max(52px,calc((100vw - var(--page-max-width))/2 + 40px));bottom:54px;border-left:1px solid rgb(255 255 255/.8);padding-left:24px;font-size:8px;font-weight:700;letter-spacing:.22em;line-height:1.7}
  @media (max-width:1320px){.showcase{min-height:820px}.showcase-copy{width:min(650px,56%)}.road-message,.performance-message{display:none}.benefits li{padding-inline:12px}}
  @media (max-width:1023px){.showcase{min-height:900px}.showcase-wash{background:linear-gradient(90deg,rgb(250 249 246/.98) 0%,rgb(250 249 246/.93) 48%,rgb(250 249 246/.44) 66%,transparent 82%)}.showcase-copy{width:min(620px,68%)}.showcase-actions{align-items:flex-start;flex-direction:column;gap:18px}.benefits{width:100%}.pirelli-badge{right:32px}}
  @media (max-width:767px){.showcase{min-height:0;scroll-margin-top:calc(var(--header-mobile-height) + 16px)}.showcase-media{right:0;bottom:auto;height:300px}.showcase-media :global(img){object-position:69% center}.showcase-wash{bottom:auto;height:301px;background:linear-gradient(180deg,transparent 52%,#f5f3ee 100%)}.showcase-content{display:block;min-height:0;padding-top:278px;padding-bottom:44px}.showcase-copy{width:100%}.brand-line{gap:12px;margin-bottom:18px;font-size:10px;letter-spacing:.18em}.brand-line::after{width:46px}h2{font-size:clamp(32px,9vw,38px);line-height:.98}h2 strong{white-space:normal}.showcase-intro{margin-top:18px}.authorization{min-height:0;gap:15px;padding:17px}.authorization svg{width:36px}.authorization-divider{height:44px}.authorization p span{font-size:10px;letter-spacing:.14em}.authorization p strong{font-size:16px;letter-spacing:.12em}.services-block>h3{font-size:20px}.services-grid{grid-template-columns:1fr}.service-card{min-height:0}.showcase-actions,.showcase-cta{width:100%}.benefits li{align-items:flex-start;flex-direction:column;gap:7px;padding-inline:12px}.pirelli-badge{top:18px;right:20px}.pirelli-badge :global(img){width:142px}.pirelli-badge span{font-size:5px}}
  @media (max-width:420px){.showcase-media,.showcase-wash{height:245px}.showcase-content{padding-top:226px}.pirelli-badge :global(img){width:118px}.pirelli-badge span{display:none}.authorization{align-items:flex-start}.authorization-divider{height:68px}.benefits{grid-template-columns:1fr;gap:12px}.benefits li{min-height:36px;align-items:center;flex-direction:row;border-left:0;border-bottom:1px solid rgb(0 0 0/.14);padding:0 0 12px}}
</style>
