---
import { getImage } from 'astro:assets';
import { homeAssets, assetMode } from '../../data/assets';
import { createWhatsAppUrl } from '../../data/contact';
import bannerVideoUrl from '../../../banner.mp4?url';

const quoteWhatsAppUrl = createWhatsAppUrl(
  'Hola, quiero cotizar llantas para mi vehículo. ¿Me pueden ayudar?',
);
const bestSellersWhatsAppUrl = createWhatsAppUrl(
  'Hola, quiero conocer los paquetes de llantas más vendidos y recibir una cotización. ¿Me pueden ayudar?',
);
const highPerformanceWhatsAppUrl = createWhatsAppUrl(
  'Hola, quiero información y una cotización de llantas High Performance para mi vehículo. ¿Me pueden ayudar?',
);

const desktopAvif = await getImage({ src: homeAssets.hero, widths: [640, 960, 1280, 1600, 1920], sizes: '100vw', format: 'avif' });
const desktopWebp = await getImage({ src: homeAssets.hero, widths: [640, 960, 1280, 1600, 1920], sizes: '100vw', format: 'webp' });
const mobileAvif = await getImage({ src: homeAssets.heroMobile, widths: [480, 720, 960], sizes: '100vw', format: 'avif' });
const mobileWebp = await getImage({ src: homeAssets.heroMobile, widths: [480, 720, 960], sizes: '100vw', format: 'webp' });
---

<section class="hero" aria-labelledby="hero-title" data-asset-mode={assetMode}>
  <picture class="hero-picture">
    <source media="(max-width: 767px)" type="image/avif" srcset={mobileAvif.srcSet.attribute} sizes="100vw" />
    <source media="(max-width: 767px)" type="image/webp" srcset={mobileWebp.srcSet.attribute} sizes="100vw" />
    <source type="image/avif" srcset={desktopAvif.srcSet.attribute} sizes="100vw" />
    <source type="image/webp" srcset={desktopWebp.srcSet.attribute} sizes="100vw" />
    <img
      src={desktopWebp.src}
      srcset={desktopWebp.srcSet.attribute}
      sizes="100vw"
      width={homeAssets.hero.width}
      height={homeAssets.hero.height}
      alt="Automóvil de alto desempeño sobre una carretera al atardecer"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <video
    class="hero-video"
    data-hero-video
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={desktopWebp.src}
    aria-hidden="true"
  >
    <source src={bannerVideoUrl} type="video/mp4" />
  </video>
  <div class="hero-shade"></div>
  <div class="hero-content container">
    <h1 id="hero-title">
      <span>LLANTAS PARA</span>
      <span>CADA VEHÍCULO.</span>
    </h1>
    <p>
      Encuentra llantas para auto, SUVs, pickups, deportivos y vehículos de alto rendimiento. Recibe asesoría
      personalizada.
    </p>
    <a
      class="btn btn--outline"
      href={quoteWhatsAppUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Cotiza ahora por WhatsApp; se abre en una nueva pestaña"
    >Cotiza ahora</a>
  </div>

  <button class="media-control" type="button" aria-label="Pausar video del encabezado" data-media-control>
    <span aria-hidden="true"></span><span aria-hidden="true"></span>
  </button>

  <div class="finder-dock container" id="finder" aria-label="Buscador de llantas">
    <strong>Encuentre las llantas para su vehículo</strong>
    <div>
      <a
        class="btn btn--dark"
        href={bestSellersWhatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Consultar los más vendidos por WhatsApp; se abre en una nueva pestaña"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M12 3.25 14.1 5l2.7-.15.85 2.55 2.25 1.5-.95 2.5.95 2.5-2.25 1.5-.85 2.55-2.7-.15L12 19.55 9.9 17.8l-2.7.15-.85-2.55-2.25-1.5.95-2.5-.95-2.5 2.25-1.5.85-2.55L9.9 5 12 3.25Z" />
          <path d="m9.4 11.45 1.65 1.65 3.6-3.7" />
        </svg>
        Más vendidos
      </a>
      <a
        class="btn btn--dark desktop-size-search"
        href={highPerformanceWhatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Consultar llantas High Performance por WhatsApp; se abre en una nueva pestaña"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M4.2 17.4a8.5 8.5 0 1 1 15.6 0" />
          <path d="M7 15.5a5.7 5.7 0 0 1 10 0M12 12l4-4" />
          <circle cx="12" cy="12" r="1.35" />
        </svg>
        High Performance
      </a>
    </div>
  </div>
</section>

<script>
  const mediaControl = document.querySelector<HTMLButtonElement>('[data-media-control]');
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');

  const setMediaState = (paused: boolean) => {
    if (!mediaControl) return;
    mediaControl.dataset.paused = String(paused);
    mediaControl.setAttribute('aria-label', paused ? 'Reproducir video del encabezado' : 'Pausar video del encabezado');
  };

  const startHeroVideo = async () => {
    if (!heroVideo) return;
    heroVideo.muted = true;
    heroVideo.defaultMuted = true;
    heroVideo.playsInline = true;
    try {
      await heroVideo.play();
      setMediaState(false);
    } catch {
      setMediaState(true);
    }
  };

  if (heroVideo) {
    if (heroVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
      void startHeroVideo();
    } else {
      heroVideo.addEventListener('canplay', startHeroVideo, { once: true });
    }

    window.addEventListener('pageshow', () => void startHeroVideo());
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && mediaControl?.dataset.paused !== 'true') void startHeroVideo();
    });
  }

  mediaControl?.addEventListener('click', async () => {
    if (!heroVideo) return;
    if (heroVideo.paused) {
      await startHeroVideo();
    } else {
      heroVideo.pause();
      setMediaState(true);
    }
  });
</script>

<style>
  .hero{position:relative;height:100svh;min-height:720px;overflow:hidden;background:#31230f;color:var(--color-paper)}
  :global(.hero-picture),.hero-video{position:absolute;inset:0;width:100%;height:100%}:global(.hero-picture img),.hero-video{width:100%;height:100%;object-fit:cover;object-position:center 58%}
  .hero-shade{position:absolute;z-index:1;inset:0;background:linear-gradient(90deg,rgb(0 0 0/.62) 0%,rgb(0 0 0/.12) 48%,rgb(0 0 0/.06) 100%),linear-gradient(180deg,rgb(0 0 0/.28),transparent 36%,rgb(0 0 0/.12))}
  .hero-content{position:relative;z-index:2;padding-top:clamp(150px,18.6vh,168px)}
  h1{max-width:1100px;margin:0;font-size:var(--type-display);line-height:1;letter-spacing:-.035em}h1 span{display:block}.hero-content p{max-width:760px;margin:22px 0 28px;font-size:var(--type-body);font-weight:500;line-height:1.5}.hero-content .btn{min-width:160px}
  .media-control{position:absolute;z-index:3;right:20px;bottom:180px;display:flex;width:36px;height:38px;align-items:center;justify-content:center;gap:3px;border-radius:4px 0 0 4px;background:rgb(255 255 255/.08);cursor:pointer}.media-control span{width:3px;height:11px;background:white}.media-control[data-paused="true"] span:first-child{width:12px;height:12px;background:white;clip-path:polygon(0 0,100% 50%,0 100%)}.media-control[data-paused="true"] span:last-child{display:none}
  .finder-dock{position:absolute;z-index:3;right:0;bottom:80px;left:0;display:flex;min-height:92px;align-items:center;gap:32px;border-radius:4px;padding:24px 32px;background:var(--color-yellow);color:var(--color-ink)}.finder-dock>strong{font-size:20px;font-weight:500}.finder-dock>div{display:flex;gap:8px;margin-left:auto}.finder-dock .btn{min-width:290px;gap:12px}.finder-dock svg{width:24px;height:24px;flex:0 0 auto;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  @media (max-width:1180px){.finder-dock{gap:18px;padding-inline:24px}.finder-dock .btn{min-width:210px}.finder-dock>strong{font-size:16px}}
  @media (min-width:768px) and (max-width:900px){.hero-content{padding-top:120px}.finder-dock{bottom:32px}.finder-dock>div{flex:1}.finder-dock .btn{min-width:0;flex:1}.media-control{bottom:150px}}
  @media (max-width:767px){
    .hero{height:auto;min-height:max(720px,100svh)}.hero-shade{background:linear-gradient(180deg,rgb(0 0 0/.58),rgb(0 0 0/.1) 48%,rgb(0 0 0/.38))}:global(.hero-picture img),.hero-video{object-position:58% center}
    .hero-content{padding-top:94px}.hero-content h1{max-width:360px;line-height:1.08}.hero-content p{max-width:360px;margin:14px 0 20px;line-height:1.5}.hero-content .btn{min-width:136px}
    .media-control{right:12px;bottom:216px;width:44px;height:44px}.finder-dock{bottom:16px;display:block;min-height:180px;padding:16px}.finder-dock>strong{display:block;margin-bottom:12px;font-size:var(--type-body);line-height:1.4}.finder-dock>div{display:grid;gap:8px;margin:0}.finder-dock .btn{width:100%;min-width:0;white-space:nowrap}
  }
  @media (min-width:520px) and (max-width:767px){.finder-dock{min-height:126px}.finder-dock>div{grid-template-columns:1fr 1fr}.media-control{bottom:160px}}
  @media (max-width:359px){.finder-dock{padding:14px}}
</style>
